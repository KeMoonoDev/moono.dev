---
import CenterContent from "../CenterContent.astro";
import cardboardForeground from "../../assets/cardboard/foreground.webp";
import { slide } from "astro/virtual-modules/transitions.js";
---

<CenterContent>
    <div
        class="content-background"
        transition:name="main-content"
        transition:animate={slide({ duration: "0.2s" })}
    >
        <slot />
    </div>
</CenterContent>

<style
    define:vars={{
        background: `url("${cardboardForeground.src}")`,
    }}
>
    .content-background {
        background-image: var(--background);
        background-repeat: repeat;
        background-size: 125%;
        padding: 12px;
        border-radius: 24px;
        background-color: white;
        box-shadow: 0 0 18px -6px;
    }
</style>
