---
import CloudsBackground from "../components/backgrounds/CloudsBackground.astro";
import NavBar from "../components/NavBar.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout title={title} id="clouds">
    <slot />
    <div slot="background">
        <CloudsBackground />
    </div>
    <div slot="nav-bar">
        <NavBar />
    </div>
</Layout>

<style is:global>
    #clouds h1 {
        text-align: center;
    }

    #clouds > * {
        font-family: "Lunasima", sans-serif;
    }
</style>
