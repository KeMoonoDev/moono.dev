---
import CardboardBackground from "@components/backgrounds/CardboardBackground.astro";
import NavBarCardboard from "@components/navigation/NavBarCardboard.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout title={title} id="cardboard">
    <slot />
    <div slot="background">
        <CardboardBackground />
    </div>
    <div slot="nav-bar">
        <NavBarCardboard />
    </div>
</Layout>

<style is:global>
    #cardboard > * {
        font-family: "Fredericka the Great", serif;
        letter-spacing: 0.5px;
        text-shadow:
            0.5px 0 0 rgb(13, 0, 26, 0.3),
            -0.5px 0 0 rgb(13, 0, 26, 0.3),
            0 0.5px 0 rgb(13, 0, 26, 0.3),
            0 -0.5px 0 rgb(13, 0, 26, 0.3),
            0.3px 0.3px 0 rgb(13, 0, 26, 0.3),
            -0.3px 0.3px 0 rgb(13, 0, 26, 0.3),
            0.3px -0.3px 0 rgb(13, 0, 26, 0.3),
            -0.3px -0.3px 0 rgb(13, 0, 26, 0.3);
    }

    strong {
        letter-spacing: 1.25px;
    }

    #cardboard .warning > * {
        text-shadow:
            0.5px 0 0 rgb(76, 0, 0, 0.3),
            -0.5px 0 0 rgb(76, 0, 0, 0.3),
            0 0.5px 0 rgb(76, 0, 0, 0.3),
            0 -0.5px 0 rgb(76, 0, 0, 0.3),
            0.3px 0.3px 0 rgb(76, 0, 0, 0.3),
            -0.3px 0.3px 0 rgb(76, 0, 0, 0.3),
            0.3px -0.3px 0 rgb(76, 0, 0, 0.3),
            -0.3px -0.3px 0 rgb(76, 0, 0, 0.3);
        color: rgb(76, 0, 0);
    }

    #cardboard a {
        text-shadow:
            0.5px 0 0 rgb(55, 0, 151, 0.3),
            -0.5px 0 0 rgb(55, 0, 151, 0.3),
            0 0.5px 0 rgb(55, 0, 151, 0.3),
            0 -0.5px 0 rgb(55, 0, 151, 0.3),
            0.3px 0.3px 0 rgb(55, 0, 151, 0.3),
            -0.3px 0.3px 0 rgb(55, 0, 151, 0.3),
            0.3px -0.3px 0 rgb(55, 0, 151, 0.3),
            -0.3px -0.3px 0 rgb(55, 0, 151, 0.3);
        color: rgb(35, 0, 116);
    }

    #cardboard a:hover {
        text-shadow:
            0.5px 0 0 rgb(55, 0, 151, 0.3),
            -0.5px 0 0 rgb(55, 0, 151, 0.3),
            0 0.5px 0 rgb(55, 0, 151, 0.3),
            0 -0.5px 0 rgb(55, 0, 151, 0.3),
            0.3px 0.3px 0 rgb(55, 0, 151, 0.3),
            -0.3px 0.3px 0 rgb(55, 0, 151, 0.3),
            0.3px -0.3px 0 rgb(55, 0, 151, 0.3),
            -0.3px -0.3px 0 rgb(55, 0, 151, 0.3);
        color: rgb(55, 0, 151);
    }

    #cardboard h1 {
        letter-spacing: 1.25px;
        color: rgb(13, 0, 26);
        font-size: 54px;
        text-align: center;
    }

    #cardboard h2 {
        letter-spacing: 1.25px;
        color: rgb(13, 0, 26);
        font-size: 36px;
        text-align: center;
    }

    #cardboard h3 {
        letter-spacing: 1.25px;
        color: rgb(13, 0, 26);
        font-size: 28px;
        text-align: center;
    }

    #cardboard h4 {
        letter-spacing: 1.25px;
        color: rgb(13, 0, 26);
        font-size: 24px;
    }

    #cardboard ul {
        color: rgb(13, 0, 26);
        font-size: 24px;
    }

    #cardboard p {
        color: rgb(13, 0, 26);
        font-size: 24px;
    }

    #cardboard summary {
        color: rgb(13, 0, 26);
        font-size: 20px;
    }

    #cardboard .anchor-target {
        animation: cardboardAnchorTarget 2s ease;
        animation-fill-mode: forwards;
    }

    @keyframes cardboardAnchorTarget {
        0% {
            background-color: #fff94b00;
        }
        12.5% {
            background-color: #fff94b7f;
        }
        25% {
            background-color: #fff94b33;
        }
        37.5% {
            background-color: #fff94b7f;
        }
        50% {
            background-color: #fff94b33;
        }
        62.5% {
            background-color: #fff94b7f;
        }
        75% {
            background-color: #fff94b33;
        }
        87.5% {
            background-color: #fff94b7f;
        }
        100% {
            background-color: #fff94b00;
        }
    }
</style>
