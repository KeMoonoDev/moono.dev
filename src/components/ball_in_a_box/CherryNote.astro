---
import CherryNote from "@assets/cutouts/Post3Ball.webp";
import { Image } from "astro:assets";
---

<div>
    <Image src={CherryNote} loading="eager" alt="Ball note" width="190" />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }
    img {
        position: absolute;
        top: -100px;
        right: calc(50% - 555px);
        rotate: -10deg;
    }
</style>
