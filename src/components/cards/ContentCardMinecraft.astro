---
import CenterContent from "@components/CenterContent.astro";
import { slide } from "astro/virtual-modules/transitions.js";
---

<CenterContent>
    <div
        class="content-background"
        transition:name="main-content"
        transition:animate={slide({ duration: "0.2s" })}
    >
        <slot />
    </div>
</CenterContent>

<style>
    .content-background {
        padding: 32px calc(min(32px, 2vw)) 32px calc(min(32px, 2vw));
        background-color: rgba(0, 0, 0, 0.5);
        border: 4px solid rgba(0, 0, 0, 0.75);
        outline: 4px solid rgb(127, 127, 127, 0.5);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
    }
</style>
