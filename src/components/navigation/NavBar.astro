---
import NavItem from "./NavItem.astro";
import CloudsBackgroundPanelImage from "@assets/clouds_background_panel.webp";
---

<nav transition:name="nav-bar" transition:animate="fade">
    <div class="nav_items">
        <img class="overlap" src={CloudsBackgroundPanelImage.src} />
        <div class="overlap buttons">
            <NavItem href="/">Home</NavItem>
            <NavItem href="/about">About</NavItem>
            <NavItem href="/projects">Projects</NavItem>
        </div>
    </div>
</nav>

<style>
    nav {
        pointer-events: none;
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    img {
        width: 100%;
        top: -53%; /* Originally -110px */
        filter: drop-shadow(0 0 10px #0009);
    }

    .buttons {
        top: -58%; /* Originally -120px */
    }

    .overlap {
        width: calc(min(800px, 140vw));
        pointer-events: all;
        grid-area: 1/1;
        position: relative;
        display: flex;
        align-items: end;
        justify-content: center;
    }

    .nav_items {
        pointer-events: none;
        display: grid;
    }
</style>
