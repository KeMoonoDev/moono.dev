---
const { action, service, href, shadow = "0" } = Astro.props;
const src = `https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/compact-minimal/${action}/${service}_vector.svg`;
---

{
    href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
            <img alt={service} height="40" src={src} />
        </a>
    ) : (
        <img alt={service} height="40" src={src} />
    )
}

<style
    define:vars={{
        shadow: `${shadow}px`,
    }}
>
    img {
        filter: drop-shadow(0 0 var(--shadow) rgba(0, 0, 0, 0.4));
    }

    a:hover,
    a:focus {
        filter: brightness(150%);
    }
</style>
