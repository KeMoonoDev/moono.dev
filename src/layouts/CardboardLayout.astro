---
import CardboardBackground from "../components/backgrounds/CardboardBackground.astro";
import NavBarCardboard from "../components/NavBarCardboard.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout title={title} id="cardboard">
    <slot />
    <div slot="background">
        <CardboardBackground />
    </div>
    <div slot="nav-bar">
        <NavBarCardboard />
    </div>
</Layout>

<style is:global>
    #cardboard > * {
        font-family: "Fredericka the Great", serif;
    }
    #cardboard p {
        font-size: 22px;
    }
</style>
