---
import { Image } from "astro:assets";

const { action, service, href, style = "" } = Astro.props;
const src = `https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/cozy/${action}/${service}_vector.svg`;
---

{
    href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
            <Image
                style={style}
                alt={service}
                height="56"
                loading="eager"
                inferSize={true}
                src={src}
            />
        </a>
    ) : (
        <Image
            style={style}
            alt={service}
            height="56"
            loading="eager"
            inferSize={true}
            src={src}
        />
    )
}

<style>
    a {
        display: inline-block;
        height: 56px;
    }

    a:hover,
    a:focus {
        filter: brightness(150%);
    }
</style>
