---
import CardboardBackground from "@components/backgrounds/CardboardBackground.astro";
import NavBarCardboard from "@components/navigation/NavBarCardboard.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout title={title} id="cardboard">
    <slot />
    <div slot="background">
        <CardboardBackground />
    </div>
    <div slot="nav-bar">
        <NavBarCardboard />
    </div>
</Layout>

<style is:global>
    #cardboard > * {
        font-family: "Fredericka the Great", serif;
    }

    #cardboard h1 {
        color: rgb(13, 0, 26);
        font-size: 48px;
        text-align: center;
    }

    #cardboard h2 {
        color: rgb(13, 0, 26);
        font-size: 32px;
        text-align: center;
    }

    #cardboard h3 {
        color: rgb(13, 0, 26);
        font-size: 24px;
        text-align: center;
    }

    #cardboard ul {
        color: rgb(13, 0, 26);
        font-size: 22px;
        text-shadow: 0 0 0 #0d001abb;
    }

    #cardboard p {
        margin-bottom: 8px;
        color: rgb(13, 0, 26);
        font-size: 22px;
        text-shadow: 0 0 0 #0d001abb;
    }
</style>
