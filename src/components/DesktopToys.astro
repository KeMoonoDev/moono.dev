---
import BallInABoxContainer from "./BallInABoxContainer.astro";
---

<div transition:persist="desktop-toys">
    <BallInABoxContainer />
</div>

<style>
    div {
        pointer-events: none;
        position: fixed;
        top: 0;
        left: 0;
        margin: 0px;
        padding: 0px;
        width: 100%;
        height: 100%;

        view-transition-name: desktop-toys;
    }

    :root::view-transition-group(desktop-toys) {
        animation: none;
    }
</style>
