---
import AliceNote from "@assets/cutouts/Post1Ball.webp";
import { Image } from "astro:assets";
---

<div>
    <Image src={AliceNote} loading="eager" alt="Ball note" width="190" />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }

    img {
        position: absolute;
        top: -30px;
        left: calc(50% - 440px);
        rotate: 5deg;

        @media (max-width: 910px) {
            left: calc(50% - 370px);
        }

        @media (max-width: 765px) {
            top: 55px;
            left: calc(50% - 300px);
        }

        @media (max-width: 625px) {
            display: none;
        }
    }
</style>
