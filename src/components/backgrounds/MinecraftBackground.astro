---
import Background from "../Background.astro";
---

<Background>
    <canvas id="minecraft-background"></canvas>
</Background>

<style>
    #minecraft-background {
        background-color: #4d4d4d;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }
</style>

<script>
    import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js";

    let scene: any, camera: any, renderer: any;

    const loader = new THREE.CubeTextureLoader().setPath(
        "/assets/minecraft/panorama/",
    );
    const cubeTexture = await loader.loadAsync([
        "right.webp",
        "left.webp",
        "top.webp",
        "bottom.webp",
        "back.webp",
        "front.webp",
    ]);

    window.addEventListener("resize", onWindowResize, false);
    function onWindowResize() {
        if (camera && renderer && scene) {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            render();
        }
    }

    let requestNumber: number | null = null;

    function animate() {
        if (camera && renderer && scene) {
            requestNumber = requestAnimationFrame(animate);
            let nowSecs = performance.now() / 1000;
            let revolutions = nowSecs / 250;
            let strength = 0.125;
            camera.rotation.x =
                Math.cos(revolutions * Math.PI * 2 + 1.3) * strength;
            camera.rotation.y = -revolutions * Math.PI * 2;
            render();
        }
    }

    function render() {
        renderer.render(scene, camera);
    }

    function unSetup() {
        if (requestNumber != null) cancelAnimationFrame(requestNumber);
        requestNumber = null;
        renderer = null;
        scene = null;
        camera = null;
    }

    function setup(canvas: any) {
        if (camera || renderer || scene) {
            unSetup();
        }

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(60, innerWidth / innerHeight);
        camera.rotation.order = "YXZ";

        renderer = new THREE.WebGLRenderer({
            canvas: canvas,
        });
        renderer.setSize(window.innerWidth, window.innerHeight);

        scene.background = cubeTexture;

        renderer.render(scene, camera);

        animate();
    }

    document.addEventListener("astro:before-swap", (event) => {
        let backgroundCanvas = event.newDocument.getElementById(
            "minecraft-background",
        );
        if (!backgroundCanvas) {
            unSetup();
        } else {
            setup(backgroundCanvas);
        }
    });

    // I have a sneaking suspicion astro:page-load doesn't get fired when navigating from page A to page B for the first time.
    // It's probably because I have an await to load the textures, so the astro:page-load doesn't get registered.
    // Run setup here.
    // It might break if the user quickly navigates to and from the Minecraft page.
    setup(document.getElementById("minecraft-background"));
</script>
