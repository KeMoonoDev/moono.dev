---
import CardboardBackground from "../components/backgrounds/CardboardBackground.astro";
import NavBarCardboard from "../components/NavBarCardboard.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout title={title}>
    <slot />
    <div slot="background">
        <CardboardBackground />
    </div>
    <div slot="nav-bar">
        <NavBarCardboard />
    </div>
</Layout>
