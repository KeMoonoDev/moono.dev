---
import CherryCutout from "@assets/cutouts/CherryCutout.webp";
import { Image } from "astro:assets";
---

<div>
    <Image src={CherryCutout} loading="eager" alt="Ball cutout" height="160" />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }
    img {
        position: absolute;
        top: -50px;
        right: calc(50% - 510px);
        rotate: 5deg;
        filter: drop-shadow(0px 0px 1px #000) drop-shadow(7px 2px 0.5px #0009);
    }
</style>
