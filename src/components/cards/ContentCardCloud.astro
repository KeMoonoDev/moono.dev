---
import { slide } from "astro/virtual-modules/transitions.js";
import CenterContent from "../CenterContent.astro";
import CloudRect from "@assets/clouds/cloud_rect.png";
---

<CenterContent>
    <div
        class="content-background"
        transition:name="main-content"
        transition:animate={slide({ duration: "0.2s" })}
    >
        <slot />
    </div>
</CenterContent>

<style
    define:vars={{
        background: `url("${CloudRect.src}")`,
    }}
>
    .content-background {
        padding: 32px calc(min(32px, 2vw)) 32px calc(min(32px, 2vw));
        border-image: var(--background) 81 fill round;
        border-image-width: 60px;
        border-image-outset: 5px;
        filter: drop-shadow(0 0 10px #0009);

        @media (max-width: 1150px) {
            border-image-outset: 5px 60px;
        }
    }
</style>
