---
const { action, service, href, style = "" } = Astro.props;
const src = `https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/compact-minimal/${action}/${service}_vector.svg`;
---

{
    href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
            <img style={style} alt={service} height="40" src={src} />
        </a>
    ) : (
        <img style={style} alt={service} height="40" src={src} />
    )
}

<style>
    a {
        display: inline-block;
        height: 40px;
    }

    a:hover,
    a:focus {
        filter: brightness(150%);
    }
</style>
