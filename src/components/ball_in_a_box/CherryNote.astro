---
import CherryNote from "@assets/cutouts/Post3Ball.webp";
import { Image } from "astro:assets";
---

<div>
    <Image src={CherryNote} loading="eager" alt="Ball note" width="190" />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }
    img {
        position: absolute;
        top: 10px;
        right: calc(50% - 520px);
        rotate: -10deg;

        @media (max-width: 1110px) {
            display: none;
        }
    }
</style>
