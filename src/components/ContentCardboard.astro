---
import CenterContent from "./CenterContent.astro";
import cardboard_background from "../assets/cardboard.png";
---

<CenterContent>
    <div class="content-background">
        <slot />
    </div>
</CenterContent>

<style
    define:vars={{
        cardboard_url: `url("${cardboard_background.src}")`,
    }}
>
    .content-background {
        background-image: var(--cardboard_url);
        background-repeat: repeat;
        background-size: 125%;
        padding: 12px;
        border-radius: 24px;
        background-color: white;
        box-shadow: 0 0 18px -6px;
    }
</style>
