---
import { ClientRouter, slide } from "astro:transitions";
import BallInABoxContainer from "../components/BallInABoxContainer.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<ClientRouter />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Moono! {title}</title>
	</head>

	<body>
		<slot name="background" />

		<div transition:animate="none" transition:name="fake-body">
			<main
				transition:name="main-content"
				transition:animate={slide({ duration: "0.2s" })}
			>
				<slot />
			</main>
			<slot name="nav-bar" />
		</div>
		<BallInABoxContainer />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
