---
import BallInABoxContainer from "@components/ball_in_a_box/BallInABoxContainer.astro";
---

<div transition:persist="desktop-toys">
    <BallInABoxContainer />
</div>

<style>
    div {
        pointer-events: none;
        position: fixed;
        top: 0;
        left: 0;
        margin: 0px;
        padding: 0px;
        width: 100vw;
        height: 100vh;

        view-transition-name: desktop-toys;
    }

    :root::view-transition-group(desktop-toys) {
        animation-duration: 0ms;
    }
</style>
