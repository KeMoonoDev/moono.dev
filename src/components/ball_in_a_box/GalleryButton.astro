---
import CardboardButton from "@assets/buttons/cardboard_button.webp";
---

<a href="/projects/ball_in_a_box/gallery">Gallery</a>

<style
    define:vars={{
        "cardboard-button": `url(${CardboardButton.src})`,
    }}
>
    a {
        background-color: #0000;
        background-image: var(--cardboard-button);
        background-size: 100% 100%;
        border: none;
        padding-left: 4px;
        padding-right: 10px;
        padding-bottom: 5px;
        width: calc(255px * 0.5);
        height: calc(147px * 0.45);
        font-family: "Fredericka the Great", serif;
        font-size: 26px;
        color: #0d001a !important;
        text-shadow: 0 0 0 #0d001a !important;
        text-decoration: none;
        text-align: center;
        align-content: center;
        cursor: pointer;
    }

    a:hover {
        filter: brightness(90%);
    }

    a:active {
        filter: brightness(80%);
    }
</style>
