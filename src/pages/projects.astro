---
import ContentCardEmpty from "@components/cards/ContentCardEmpty.astro";
import CloudsLayout from "@layouts/CloudsLayout.astro";
const projects = Object.values(
    import.meta.glob("./projects/*.mdx", { eager: true }),
);
console.log(projects);
---

<CloudsLayout>
    <ContentCardEmpty>
        <div class="grid">
            <div class="item">
                <a class="ball-in-a-box" href="/projects/ball_in_a_box">
                    <img
                        class="ball-in-a-box"
                        src="/projects/ball_in_a_box/banner.webp"
                        alt="Ball in a Box"
                    />
                </a>
            </div>
            <div class="item">
                <a href="/projects/unloaded_activity">
                    <img
                        class="unloaded-activity"
                        src="/projects/unloaded_activity/banner.webp"
                        alt="Unloaded Activity"
                    />
                </a>
            </div>
        </div>
    </ContentCardEmpty>

    <style>
        a {
            line-height: 0;
        }

        img {
            max-width: 320px;
            max-height: 172px;
        }

        .grid {
            display: flex;
            flex-wrap: wrap;
            place-content: center;
            padding: 12px;
            gap: 12px;
        }

        .item {
            max-width: 320px;
            min-width: 320px;
            height: 172px;

            /*
            background: hsl(340 80% 50%);
            border: 5px solid hsl(340 80% 70%);
            border-radius: 1rem;
            */

            display: flex;
            justify-content: center; /* Horizontally center */
            align-items: center; /* Vertically center */
        }

        .ball-in-a-box {
            border-radius: 25%;
        }

        .ball-in-a-box img:hover {
            filter: brightness(90%);
        }
        .ball-in-a-box img:active {
            filter: brightness(80%);
        }

        .unloaded-activity {
            filter: drop-shadow(0 0 6 #000a);
            border: 4px solid #000000;
        }

        .unloaded-activity:hover {
            border: 4px solid #fff;
        }
    </style>
</CloudsLayout>
