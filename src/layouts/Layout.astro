---
import { ClientRouter, slide } from "astro:transitions";
import ReplacementSwap from "astro-vtbot/components/ReplacementSwap.astro";
import Linter from "astro-vtbot/components/Linter.astro";
import CloudsBackground from "../components/CloudsBackground.astro";
import NavBar from "../components/NavBar.astro";
import BallInABoxContainer from "../components/BallInABoxContainer.astro";
import CardboardBackground from "../components/CardboardBackground.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<ClientRouter />
		<ReplacementSwap />
		<Linter />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Moono! {title}</title>
	</head>

	<body transition:animate="none">
		<main>
			<slot />
		</main>
		<CloudsBackground />
		<BallInABoxContainer />
		<NavBar />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
