---
import { slide } from "astro/virtual-modules/transitions.js";
import CenterContent from "../CenterContent.astro";
---

<CenterContent>
    <div
        class="content-background"
        transition:name="main-content"
        transition:animate={slide({ duration: "0.2s" })}
    >
        <slot />
    </div>
</CenterContent>

<style>
    .content-background {
        padding: 12px;
        border-radius: 24px;
        background-color: white;
        box-shadow: 0 0 18px -6px;
    }
</style>
