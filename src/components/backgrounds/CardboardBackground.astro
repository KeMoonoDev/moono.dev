---
import cardboardBackground from "../../assets/cardboard/background.webp";
import Background from "../Background.astro";
---

<Background>
    <div id="cardboard-background"></div>
</Background>

<style
    define:vars={{
        background: `url("${cardboardBackground.src}")`,
    }}
>
    #cardboard-background {
        background-image: var(--background);
        background-repeat: repeat;
        background-size: 75%;
        background-position-x: 50vw;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }
</style>

<script>
    let lastScrollAmount = 0;
    function updateParallax() {
        let scrollAmount = window.pageYOffset;

        let background = document.getElementById("cardboard-background");

        if (scrollAmount != lastScrollAmount) {
            if (background)
                background.style.backgroundPositionY = `-${scrollAmount / 2}px`;

            lastScrollAmount = scrollAmount;
        }

        requestAnimationFrame(updateParallax);
    }

    requestAnimationFrame(updateParallax);
</script>
