---
import cloud_layer_1 from "../assets/cloud_layer_1.webp";
import cloud_layer_2 from "../assets/cloud_layer_2.webp";
import cloud_layer_3 from "../assets/cloud_layer_3.webp";
---

<div id="clouds-background" transition:persist="clouds-background">
    <div id="sky" class="background"></div>
    <div id="bg_layer_3" class="background"></div>
    <div id="bg_layer_2" class="background"></div>
    <div id="bg_layer_1" class="background"></div>
</div>

<style
    define:vars={{
        cloud_layer_1: `url("${cloud_layer_1.src}")`,
        clouds_layer_2: `url("${cloud_layer_2.src}")`,
        cloud_layer_3: `url("${cloud_layer_3.src}")`,
    }}
>
    #clouds-background {
        z-index: -1;
    }

    .background {
        background-size: 100%;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: inherit;
        filter: blur(0.4vw);
    }

    #sky {
        background-color: #c8dce5;
        filter: none;
    }

    #bg_layer_1 {
        background-image: var(--cloud_layer_1);
        animation: bgScrollLeft 30s linear infinite;
    }

    #bg_layer_2 {
        background-image: var(--clouds_layer_2);
        animation: bgScrollLeft 60s linear infinite;
    }

    #bg_layer_3 {
        background-image: var(--cloud_layer_3);
        animation: bgScrollLeft 120s linear infinite;
    }

    @keyframes bgScrollLeft {
        from {
            background-position-x: 0;
        }
        to {
            background-position-x: -100vw;
        }
    }
</style>

<script>
    document.addEventListener("astro:before-swap", (event) => {
        let currentCloudsBackground =
            document.getElementById("clouds-background");

        console.log(currentCloudsBackground);

        console.log("Before swap");

        if (!currentCloudsBackground) return;

        console.log("Old doc did have clouds");

        let newCloudsBackground =
            event.newDocument.getElementById("clouds-background");

        console.log("Checking new doc");

        if (!newCloudsBackground) return;

        console.log("New doc did not have clouds");

        currentCloudsBackground.removeAttribute("data-astro-transition-scope");
    });
</script>

<script>
    let lastScrollAmount = 0;
    function updateParallax() {
        let scrollAmount = window.pageYOffset / window.innerWidth;

        if (scrollAmount != lastScrollAmount) {
            let layer1 = document.getElementById("bg_layer_1");
            if (layer1)
                layer1.style.backgroundPositionY = `-${scrollAmount * 120}px`;

            let layer2 = document.getElementById("bg_layer_2");
            if (layer2)
                layer2.style.backgroundPositionY = `-${scrollAmount * 60}px`;

            let layer3 = document.getElementById("bg_layer_3");
            if (layer3)
                layer3.style.backgroundPositionY = `-${scrollAmount * 30}px`;

            lastScrollAmount = scrollAmount;
        }
        requestAnimationFrame(updateParallax);
    }

    requestAnimationFrame(updateParallax);
</script>
