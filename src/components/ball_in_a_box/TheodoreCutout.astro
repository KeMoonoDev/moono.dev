---
import TheodoreCutout from "@assets/cutouts/TheodoreCutout.webp";
import { Image } from "astro:assets";
---

<div>
    <Image
        src={TheodoreCutout}
        loading="eager"
        alt="Ball cutout"
        height="175"
    />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }
    img {
        position: absolute;
        top: -30px;
        right: calc(50% - 360px);
        rotate: -20deg;
        filter: drop-shadow(0px 0px 1px #000) drop-shadow(6px 5px 0.5px #0009);
    }
</style>
