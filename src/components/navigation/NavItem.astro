---
const tempPath = Astro.url.pathname;
const { href } = Astro.props;
// In dev builds, there are no trailing slashes, but in prod builds, there are.
// Fixes this by removing all trailing slashes, unless the path is just the slash.
const modifiedPath = tempPath == "/" ? "/" : tempPath.replace(/\/+$/, "");
const modifiedHref = href == "/" ? "/" : href.replace(/\/+$/, "");
const isMatch = modifiedPath == modifiedHref;

import CloudRect from "@assets/clouds/cloud_rect.png";
---

<a href={href} class=`${ isMatch ? "disabled" : "" }`>
    <div class="button-background"></div>
    <div>
        <slot />
    </div>
</a>

<style
    define:vars={{
        background: `url("${CloudRect.src}")`,
    }}
>
    a {
        container-type: size;
        display: inline-block;
        height: min(80px, calc(33vw - 20px) / 1.875);
        max-width: calc(33vw - 20px);
        aspect-ratio: 1.875;
        margin: 10px;
        margin-top: 0px;
        margin-bottom: 0px;
        position: relative;
        text-align: center;
        color: white;
        font-weight: bolder;
    }

    a.disabled {
        pointer-events: none;
        cursor: default;
    }

    .button-background {
        transition: filter 0.2s;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 0 10px #0009);
        border-image: var(--background) 81 fill round;
        border-image-width: 30px;
        border-image-outset: 5px;
        filter: opacity(0);

        @media (max-width: 515px) {
            transition: border-image-width 0s;
            border-image-width: 6vw;
        }
    }

    a.disabled > .button-background {
        transition: filter 0.2s;
        filter: opacity(1) drop-shadow(0 0 10px #0009);
    }

    a:hover > .button-background {
        transition: filter 0.2s;
        filter: opacity(0.75) drop-shadow(0 0 10px #0005);
    }

    a:active > .button-background {
        transition: filter 0.2s;
        filter: opacity(0.75) drop-shadow(0 0 10px #0005);
    }

    div {
        font-size: 20cqw;
        color: black;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
