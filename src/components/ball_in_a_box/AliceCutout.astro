---
import AliceCutout from "@assets/cutouts/AliceCutout.webp";
import { Image } from "astro:assets";
---

<div>
    <Image src={AliceCutout} loading="eager" alt="Ball cutout" height="170" />
</div>

<style>
    div {
        width: auto;
        position: relative;
    }

    img {
        position: absolute;
        left: calc(50% - 420px);
        rotate: 10deg;
        filter: drop-shadow(0px 0px 1px #000) drop-shadow(7px 2px 0.5px #0009);
    }
</style>
