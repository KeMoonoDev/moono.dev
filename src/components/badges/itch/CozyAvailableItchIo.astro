---
import badge from "@assets/badges/cozy/itch-io_vector.svg";
const { href, style = "" } = Astro.props;
---

{
    href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">
            <img style={style} alt="itch.io" height="56" src={badge.src} />
        </a>
    ) : (
        <img style={style} alt="itch.io" height="56" src={badge.src} />
    )
}

<style>
    a {
        display: inline-block;
        height: 56px;
    }

    a:hover,
    a:focus {
        filter: brightness(115%);
    }
</style>
