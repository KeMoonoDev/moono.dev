---
import { ClientRouter, slide } from "astro:transitions";
import ReplacementSwap from "astro-vtbot/components/ReplacementSwap.astro";
import Linter from "astro-vtbot/components/Linter.astro";
import Background from "../components/Background.astro";
import NavBar from "../components/NavBar.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:persist-props>
	<head>
		<ClientRouter />
		<ReplacementSwap />
		<Linter />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Moono! {title}</title>
	</head>

	<body>
		<NavBar />
		<main transition:animate={slide({ duration: "0.2s" })}>
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
