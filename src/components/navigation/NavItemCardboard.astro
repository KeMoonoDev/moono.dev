---
const tempPath = Astro.url.pathname;
const { href } = Astro.props;
// In dev builds, there are no trailing slashes, but in prod builds, there are.
// Fixes this by removing all trailing slashes, unless the path is just the slash.
const modifiedPath = tempPath == "/" ? "/" : tempPath.replace(/\/+$/, "");
const modifiedHref = href == "/" ? "/" : href.replace(/\/+$/, "");
const isMatch = modifiedPath == modifiedHref;

import cardboardButton from "@assets/buttons/cardboard_button.webp";
---

<a href={href} class=`${ isMatch ? "disabled" : "" }`>
    <img src={cardboardButton.src} alt="Cardboard button" />
    <div>
        <slot />
    </div>
</a>

<style>
    a.disabled {
        color: green;
        pointer-events: none;
        cursor: default;
    }

    a {
        display: inline-block;
        width: 150px;
        height: 80px;
        margin: 5px;
        margin-top: 0px;
        margin-bottom: 0px;
        position: relative;
        text-align: center;
        color: white;
    }

    img {
        width: 100%;
        height: 100%;
    }

    div {
        font-size: 30px;
        color: #0d001a;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-shadow: 0 0 0 #0d001abb;
    }
</style>
