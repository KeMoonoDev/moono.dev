---
const tempPath = Astro.url.pathname;
const { href } = Astro.props;
// In dev builds, there are no trailing slashes, but in prod builds, there are.
// Fixes this by removing all trailing slashes, unless the path is just the slash.
const modifiedPath = tempPath == "/" ? "/" : tempPath.replace(/\/+$/, "");
const modifiedHref = href == "/" ? "/" : href.replace(/\/+$/, "");
const isMatch = modifiedPath == modifiedHref;
---

<a href={href} class=`${ isMatch ? "disabled" : "" }`>
    <div>
        <slot />
    </div>
</a>

<style>
    a {
        container-type: size;
        display: inline-block;
        height: min(56px, calc(33vw - 35px) / 3);
        max-width: calc(33vw - 35px);
        aspect-ratio: 3;
        margin: 4px;
        margin-top: 0px;
        position: relative;
        text-align: center;
        color: white;
        background-color: rgba(0, 0, 0, 0.9);
        border: 4px solid rgba(127, 127, 127, 0.5);
        outline: 4px solid rgba(0, 0, 0, 0.9);
        border-top: 0px;
        padding: 10px;
        padding-top: 14px;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
    }

    a:hover {
        padding-top: 10px;
        border: 4px solid #fff;
    }

    a:active {
        padding-top: 10px;
        border: 4px solid #fff;
    }

    a:hover > div {
        margin-top: 0px;
    }

    a:hover > div {
        margin-top: 0px;
    }

    div {
        margin-top: 2px;
        font-size: 18cqw;
        text-shadow: 0.11em 0.11em 0 #3f3f3f;
        color: #fff;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
